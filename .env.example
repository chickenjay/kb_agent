# No configuration is needed for explicit offline Mock mode.
# Optional shell overrides for config.local.toml. This .env example itself is
# NOT loaded automatically; config.local.toml is loaded by the backend and CLI.
LLM_BASE_URL=https://api.deepseek.com
LLM_API_KEY=
LLM_MODEL=deepseek-flash
# Optional local runtime output location; defaults to .runtime/runs
# KB_RUNS_DIR=.runtime/runs
